---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Gehackt ist Geil" description="Diese Seite gibt es nicht.">
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <span class="no mono">§404 — Nicht gefunden</span>
        <h1 class="page-title">Kein<br />Flag hier</h1>
        <p class="page-lead">
          Die Seite existiert nicht (mehr). Kein Exploit nötig — der Weg zurück ist ganz normal
          verlinkt.
        </p>
        <div class="contact-row">
          <a class="btn btn--blue" href="/">Zur Startseite <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </main>
</Base>
