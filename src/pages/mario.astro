---
import Base from "../layouts/Base.astro";
import { contributions, projects } from "../data/oss";
import { CTFTIME_TEAM, CTFTIME_USER, CONTACT_MAIL, GITHUB } from "../data/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mario Madersbacher",
  alternateName: "Telqrrrr",
  url: "https://gig-gehacktistgeil.com/mario/",
  jobTitle: "Security- und Netzwerk-Schüler",
  address: { "@type": "PostalAddress", addressRegion: "Tirol", addressCountry: "AT" },
  memberOf: { "@type": "Organization", name: "Gehackt ist Geil" },
  sameAs: [GITHUB, CTFTIME_USER.telqrrrr],
};
---

<Base
  title="Mario Madersbacher — Security & Netzwerke"
  description="Mario Madersbacher (Telqrrrr) aus Tirol: Open-Source-Beiträge zu Scapy, Impacket, Sigma und Nuclei, eigene Netzwerk- und Security-Tools in Rust und Go, CTFs mit «Gehackt ist Geil»."
  ogTitle="Mario Madersbacher — Security & Netzwerke"
  jsonLd={jsonLd}
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <div class="hero-kicker">
          <span class="tag tag--blue">Telqrrrr</span>
          <span class="tag">Tirol · Österreich</span>
          <span class="tag">Security &amp; Netzwerke</span>
        </div>
        <h1 class="page-title">Mario<br />Madersbacher</h1>
        <p class="page-lead">
          18, HAK in Tirol, und der Großteil der Energie geht in Security und Netzwerke. Wenn ich
          nicht verstehe, wie sich etwas verhält, schreibe ich meistens das Tool, das es mir zeigt.
          Rust und Go, wenn es schnell sein muss, Python wenn ich nur die Antwort will. Linux als
          Alltagssystem.
        </p>
        <p class="page-lead sub">
          Nebenbei spiele ich CTFs mit <a href="/">«Gehackt ist Geil»</a> — diese Seite ist auch
          von mir.
        </p>
      </div>

      <!-- OPEN SOURCE -->
      <section class="sub-sec">
        <div class="sec-head reveal">
          <h2>Open Source</h2>
          <span class="no">§A — Upstream</span>
        </div>
        <p class="sub-lead reveal">
          Kein Fork-Friedhof: Änderungen an Projekten, die andere Leute wirklich benutzen. Jede
          Zeile hier ist ein Pull Request im Original-Repo.
        </p>
        <div class="oss-list">
          {contributions.map((c) => (
            <a class="oss-row reveal" href={c.url} target="_blank" rel="noopener">
              <span class="sweep"></span>
              <span class="oss-main">
                <span class="oss-name">
                  {c.project}
                  <span class={`state state--${c.state}`}>{c.state === "merged" ? "gemerged" : "offen"}</span>
                </span>
                <span class="oss-what">{c.what}</span>
              </span>
              <span class="oss-repo mono">{c.repo} ↗</span>
            </a>
          ))}
        </div>
      </section>

      <!-- TOOLS -->
      <section class="sub-sec">
        <div class="sec-head reveal">
          <h2>Eigene Tools</h2>
          <span class="no">§B — Werkstatt</span>
        </div>
        <div class="crew-grid">
          {projects.map((p) => (
            <article class="card reveal">
              <div class="handle" style="margin-top:0">{p.name}</div>
              <div class="role">{p.lang}</div>
              <p class="bio">{p.what}</p>
              <div class="links">
                <a href={p.url} target="_blank" rel="noopener">Repo ↗</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- CTF / PAPIERKRAM -->
      <section class="sub-sec">
        <div class="sec-head reveal">
          <h2>CTF &amp; Papierkram</h2>
          <span class="no">§C — Belege</span>
        </div>
        <div class="facts">
          <div class="fact reveal">
            <span class="k mono">CTF</span>
            <p>
              Spiele mit <a href={CTFTIME_TEAM} target="_blank" rel="noopener">Gehackt ist Geil</a>,
              beste Platzierung bisher Platz&nbsp;2 bei MntcrlCTF&nbsp;2026.
              Eigenes Profil: <a href={CTFTIME_USER.telqrrrr} target="_blank" rel="noopener">ctftime.org/user/264976</a>.
            </p>
          </div>
          <div class="fact reveal">
            <span class="k mono">Zertifikate</span>
            <p>TryHackMe Junior Penetration Tester (PT1) und AI Security (AI1), beide 2026.</p>
          </div>
          <div class="fact reveal">
            <span class="k mono">Bug Bounty</span>
            <p>
              Angenommene Reports in öffentlichen und privaten Programmen. Details bleiben dort, wo
              sie hingehören — bei den Programmen.
            </p>
          </div>
          <div class="fact reveal">
            <span class="k mono">Gerade dran</span>
            <p>Netzwerkprotokolle, Reverse Engineering und Rust. Und daran, weniger Tabs offen zu haben.</p>
          </div>
        </div>
      </section>

      <!-- KONTAKT -->
      <section class="sub-sec">
        <div class="sec-head reveal">
          <h2>Kontakt</h2>
          <span class="no">§D — Erreichbar</span>
        </div>
        <div class="contact-row reveal">
          <a class="btn" href={GITHUB} target="_blank" rel="noopener">GitHub <span class="arrow">→</span></a>
          <a class="btn" href={CTFTIME_USER.telqrrrr} target="_blank" rel="noopener">CTFtime <span class="arrow">→</span></a>
          <a class="btn btn--blue" href={`mailto:${CONTACT_MAIL}`}>E-Mail <span class="arrow">→</span></a>
        </div>
        <p class="note mono reveal" style="margin-top:14px">
          Mails laufen über eine Relay-Adresse — kommt trotzdem an.
        </p>
      </section>
    </div>
  </main>
</Base>
