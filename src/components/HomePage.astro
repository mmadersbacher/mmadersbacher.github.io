---
import Base from "../layouts/Base.astro";
import {
  CTFTIME_TEAM,
  CTFTIME_USER,
  CONTACT_MAIL,
  results,
  latestResult,
  isPodium,
} from "../data/site";
import { locales, localePath, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = useTranslations(lang);
const href = (p: string) => localePath(lang, p);

const IMG = "/bubensahne.png";
const AV_TELQRRRR = "/av-telqrrrr.jpg";
const AV_LUNARIC = "/av-lunaric.jpg";

// Zahlen kommen roh aus den Daten und werden hier je Sprache formatiert:
// 13.764 / 36,639 auf Deutsch, 13,764 / 36.639 auf Englisch.
const nf = new Intl.NumberFormat(locales[lang].num);
const rf = new Intl.NumberFormat(locales[lang].num, {
  minimumFractionDigits: 3,
  maximumFractionDigits: 3,
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Gehackt ist Geil",
  alternateName: "GiG",
  url: "https://gig-gehacktistgeil.com/",
  description: s.home.orgDescription,
  foundingDate: "2026",
  address: { "@type": "PostalAddress", addressCountry: "AT" },
  sameAs: [CTFTIME_TEAM],
};

const marquee = s.home.marquee;
---

<Base
  home
  lang={lang}
  title={s.home.title}
  description={s.home.description}
  ogTitle={s.home.ogTitle}
  jsonLd={jsonLd}
>
  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <div class="hero-kicker">
            <span class="tag tag--blue">{s.home.kicker[0]}</span>
            <span class="tag">{s.home.kicker[1]}</span>
            <span class="tag">{s.home.kicker[2]}</span>
          </div>
          <h1>
            <span class="line">{s.home.h1[0]}</span>
            <span class="line">{s.home.h1[1]}</span>
            <span class="line geil">{s.home.h1[2]}</span>
          </h1>
          {s.home.gloss && <p class="hero-gloss mono">{s.home.gloss}</p>}
          <p class="lead" set:html={s.home.leadHtml} />
          <div class="hero-cta">
            <a class="btn btn--blue" href={CTFTIME_TEAM} target="_blank" rel="noopener">
              {s.home.ctaTeam} <span class="arrow">→</span>
            </a>
            <a class="btn" href="#palmares">{s.home.ctaResults} <span class="arrow">↓</span></a>
          </div>
        </div>

        <div class="photo-wrap reveal">
          <div class="stamp stamp--bube">
            <span class="s1">{s.home.stampMascot[0]}</span><span class="s2"
              >{s.home.stampMascot[1]}</span
            >
          </div>
          <div class="photo-frame">
            <canvas
              id="halftone"
              width="150"
              height="123"
              role="img"
              data-src={IMG}
              aria-label={s.home.photoAlt}></canvas>
            <noscript>
              <style>
                #halftone {
                  display: none;
                }
              </style>
              <img class="photo-fallback" src={IMG} width="150" height="123" alt={s.home.photoAlt} />
            </noscript>
            <div class="photo-caption">
              <span>{s.home.photoCaption}</span>
              <span>{s.home.photoTech}</span>
            </div>
          </div>
          <div class="stamp stamp--est">
            <span class="s1">{s.home.stampEst[0]}</span><span class="s2">{s.home.stampEst[1]}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>
          {marquee.map((m) => (<>{m}<span class="dot">✶</span></>))}
        </span>
        <span>
          {marquee.map((m) => (<>{m}<span class="dot">✶</span></>))}
        </span>
      </div>
    </div>

    <!-- MANIFEST -->
    <section class="sec manifest">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2>{s.home.manifest.h2}</h2>
          <span class="no">{s.home.manifest.no}</span>
        </div>
        <p class="big reveal" set:html={s.home.manifest.bigHtml} />
        <div class="cols">
          <p class="reveal" set:html={s.home.manifest.p1Html} />
          <p class="reveal" set:html={s.home.manifest.p2Html} />
        </div>
      </div>
    </section>

    <!-- PALMARÈS -->
    <section class="sec" id="palmares">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2>{s.home.palmares.h2}</h2>
          <span class="no">{s.home.palmares.no}</span>
        </div>
        <div class="ledger">
          {
            results.map((r) => (
              <a class="row reveal" href={r.url} target="_blank" rel="noopener">
                <span class="sweep" />
                <span class="place">
                  {nf.format(r.place)}
                  <small>{s.home.palmares.place}</small>
                </span>
                <span class="ev">
                  <span class="name">
                    {r.event}
                    {r.event === latestResult.event && (
                      <span class="podium podium--new">{s.home.palmares.fresh}</span>
                    )}
                    {isPodium(r) && (
                      <span class="podium">
                        {s.home.palmares.podium}&nbsp;{r.place}
                      </span>
                    )}
                  </span>
                  <span class="meta">
                    {s.home.palmares.kind[r.kind]} · {nf.format(r.field)}{" "}
                    {s.home.palmares.teams}
                  </span>
                </span>
                <span class="num pts">
                  <span class="k">{s.home.palmares.pts}</span>
                  <span class="v">{nf.format(r.pts)}</span>
                </span>
                <span class="num">
                  <span class="k">{s.home.palmares.rating}</span>
                  <span class="v">{rf.format(r.rating)}</span>
                </span>
              </a>
            ))
          }
        </div>
        <div class="ledger-foot">
          <span class="note reveal">{s.home.palmares.note}</span>
          <a class="btn btn--sm reveal" href={CTFTIME_TEAM} target="_blank" rel="noopener">
            {s.home.palmares.full} <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CREW -->
    <section class="sec" id="crew">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2>{s.home.crew.h2}</h2>
          <span class="no">{s.home.crew.no}</span>
        </div>
        <div class="crew-grid">
          <article class="card reveal">
            <span class="idx mono">01</span>
            <div class="badge">
              <img class="av" src={AV_TELQRRRR} width="62" height="62" alt="Telqrrrr" />
            </div>
            <div class="handle">Telqrrrr</div>
            <div class="role">{s.home.crew.role}</div>
            <p class="bio">{s.home.crew.telqrrrr}</p>
            <div class="links">
              <a href={href("/mario/")}>{s.home.crew.profile} →</a>
              <a href={CTFTIME_USER.telqrrrr} target="_blank" rel="noopener">CTFtime ↗</a>
            </div>
          </article>

          <article class="card reveal">
            <span class="idx mono">02</span>
            <div class="badge badge--red">
              <img class="av" src={AV_LUNARIC} width="62" height="62" alt="Lunaric" />
            </div>
            <div class="handle">Lunaric</div>
            <div class="role">{s.home.crew.role}</div>
            <p class="bio">{s.home.crew.lunaric}</p>
            <div class="links">
              <a href={href("/lunaric/")}>{s.home.crew.profile} →</a>
              <a href={CTFTIME_USER.lunaric} target="_blank" rel="noopener">CTFtime ↗</a>
            </div>
          </article>

          <article class="card reveal">
            <span class="idx mono">03</span>
            <div class="badge badge--ink">Y</div>
            <div class="handle">Yousuf</div>
            <div class="role">{s.home.crew.role}</div>
            <p class="bio">{s.home.crew.yousuf}</p>
            <div class="links">
              <a href={CTFTIME_USER.yousuf} target="_blank" rel="noopener">CTFtime ↗</a>
            </div>
          </article>

          <article class="card card--join reveal">
            <span class="q" set:html={s.home.crew.joinQ} />
            <p class="bio" style="margin-top:0">{s.home.crew.joinText}</p>
            <a class="btn btn--sm btn--red" href={`mailto:${CONTACT_MAIL}`}>
              {s.home.crew.joinCta} <span class="arrow">→</span>
            </a>
            <a class="join-mail mono" href={`mailto:${CONTACT_MAIL}`}>{CONTACT_MAIL}</a>
          </article>
        </div>
      </div>
    </section>

    <!-- JOIN BAND -->
    <section class="band">
      <div class="wrap">
        <h2>{s.home.band.h2}</h2>
        <a class="btn btn--red" href={CTFTIME_TEAM} target="_blank" rel="noopener">
          {s.home.band.cta} <span class="arrow">→</span>
        </a>
      </div>
    </section>
  </main>

  <script>
    // Halftone-Duotone des Maskottchens — live gerastert.
    //
    // Zwei Dinge müssen stimmen, sonst wird daraus Pixelmatsch:
    //
    // 1. Der Bitmap-Puffer muss exakt so groß sein wie die Anzeige in Geräte-
    //    pixeln. Vorher lag er fest auf 760px und wurde vom Browser auf ~430px
    //    heruntergerechnet — ein hartes Punktraster überlebt das Downsampling
    //    nicht und wird zu Moiré. Am Handy fiel es nicht auf, weil dort die
    //    hohe Pixeldichte zufällig fast 1:1 traf.
    // 2. Die Vorlage ist dunkel (Median-Luminanz ~0.18). Ohne Tonwertkorrektur
    //    ist über die Hälfte der Punkte am Anschlag und läuft zu einer
    //    schwarzen Fläche zusammen. Deshalb: auf den tatsächlichen Umfang
    //    normalisieren und die Gamma so wählen, dass die mittlere Deckung
    //    passt — das funktioniert auch, wenn das Bild mal getauscht wird.
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const GAP_CSS = 6; // Rasterweite in CSS-Pixeln — bleibt auf jedem Display gleich
    const MAX_R = 0.62; // größter Punktradius als Vielfaches der Rasterweite
    const TARGET_INK = 0.5; // angepeilte mittlere Deckung
    const OFF_X = 1.5; // Versatz der blauen Platte, CSS-Pixel
    const OFF_Y = 1.1;
    const INK = "#17140e";
    const BLUE = "#1f2ae6";
    const PAPER = "#ece3ce";

    function initHalftone() {
      const el = document.getElementById("halftone");
      if (!(el instanceof HTMLCanvasElement)) return;
      const canvas = el;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let cells: { x: number; y: number; dark: number }[] = [];
      let gamma = 1;
      let gap = GAP_CSS;
      let dpr = 1;

      const img = new Image();
      img.decoding = "async";

      /** Sucht die Gamma, bei der mean(dark^g) ≈ TARGET_INK ist. */
      function solveGamma(dark: number[]): number {
        let lo = 0.25;
        let hi = 6;
        for (let i = 0; i < 24; i++) {
          const g = (lo + hi) / 2;
          let m = 0;
          for (let k = 0; k < dark.length; k++) m += Math.pow(dark[k], g);
          m /= dark.length;
          // mean(d^g) fällt monoton mit g, weil alle d in [0,1] liegen.
          if (m > TARGET_INK) lo = g;
          else hi = g;
        }
        return (lo + hi) / 2;
      }

      /**
       * Luminanz je Rasterzelle. Statt einzelne Pixel abzutasten, wird das Bild
       * auf genau die Zellenanzahl verkleinert — der Browser mittelt dabei über
       * die Fläche, was Aliasing vermeidet und feine Strukturen erhält.
       */
      function buildCells(cols: number, rows: number) {
        const off = document.createElement("canvas");
        off.width = cols;
        off.height = rows;
        const octx = off.getContext("2d", { willReadFrequently: true });
        if (!octx) return;
        octx.imageSmoothingEnabled = true;
        octx.imageSmoothingQuality = "high";
        octx.drawImage(img, 0, 0, cols, rows);
        const data = octx.getImageData(0, 0, cols, rows).data;

        const lum: number[] = new Array(cols * rows);
        for (let i = 0, p = 0; i < lum.length; i++, p += 4) {
          lum[i] = (0.299 * data[p] + 0.587 * data[p + 1] + 0.114 * data[p + 2]) / 255;
        }

        // Auf den tatsächlich belegten Tonwertumfang strecken (2%/98%-Perzentil,
        // damit einzelne Ausreißer die Skala nicht kippen).
        const sorted = lum.slice().sort((a, b) => a - b);
        const loL = sorted[Math.floor(sorted.length * 0.02)];
        const hiL = sorted[Math.floor(sorted.length * 0.98)];
        const span = Math.max(1e-3, hiL - loL);

        const dark: number[] = new Array(lum.length);
        cells = new Array(lum.length);
        for (let i = 0; i < lum.length; i++) {
          const n = (lum[i] - loL) / span;
          dark[i] = n < 0 ? 1 : n > 1 ? 0 : 1 - n;
          const cx = i % cols;
          const cy = (i / cols) | 0;
          cells[i] = { x: (cx + 0.5) * gap, y: (cy + 0.5) * gap, dark: dark[i] };
        }
        gamma = solveGamma(dark);
      }

      function draw(progress: number) {
        if (!ctx) return;
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = PAPER;
        ctx.fillRect(0, 0, w, h);
        const maxR = gap * MAX_R;
        for (let pass = 0; pass < 2; pass++) {
          ctx.fillStyle = pass === 0 ? BLUE : INK;
          const ox = pass === 0 ? OFF_X * dpr : 0;
          const oy = pass === 0 ? OFF_Y * dpr : 0;
          ctx.beginPath();
          for (const c of cells) {
            let p = progress;
            if (progress < 1) {
              const local = c.x / w;
              p = Math.max(0, Math.min(1, progress * 1.5 - local * 0.5));
            }
            const r = Math.pow(c.dark, gamma) * maxR * p;
            if (r > 0.15) {
              ctx.moveTo(c.x + ox + r, c.y + oy);
              ctx.arc(c.x + ox, c.y + oy, r, 0, 6.2832);
            }
          }
          ctx.fill();
        }
      }

      /** Puffer auf die echte Anzeigegröße bringen und neu rastern. */
      function layout(): boolean {
        const cssW = canvas.clientWidth;
        if (!cssW || !img.naturalWidth) return false;
        dpr = Math.min(window.devicePixelRatio || 1, 3);
        gap = GAP_CSS * dpr;
        const cols = Math.max(1, Math.round((cssW * dpr) / gap));
        const rows = Math.max(1, Math.round((cols * img.naturalHeight) / img.naturalWidth));
        canvas.width = Math.round(cols * gap);
        canvas.height = Math.round(rows * gap);
        buildCells(cols, rows);
        return true;
      }

      function paintStatic() {
        if (layout()) draw(1);
      }

      img.onload = () => {
        if (!layout()) return;
        if (reduce) {
          draw(1);
        } else {
          const start = performance.now();
          const DUR = 1100;
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / DUR);
            draw(1 - Math.pow(1 - t, 3));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }

        // Breite oder Pixeldichte ändern sich (Fenster, Zoom, anderer Monitor):
        // neu rastern, sonst ist das Raster wieder falsch skaliert.
        let last = canvas.clientWidth;
        let lastDpr = window.devicePixelRatio || 1;
        let timer = 0;
        const onResize = () => {
          const nowW = canvas.clientWidth;
          const nowDpr = window.devicePixelRatio || 1;
          if (nowW === last && nowDpr === lastDpr) return;
          last = nowW;
          lastDpr = nowDpr;
          clearTimeout(timer);
          timer = window.setTimeout(paintStatic, 120);
        };
        if ("ResizeObserver" in window) new ResizeObserver(onResize).observe(canvas);
        else addEventListener("resize", onResize);
      };

      img.onerror = () => {
        // Bild fehlt: leere Papierfläche statt kaputtem Kasten.
        if (!ctx) return;
        ctx.fillStyle = PAPER;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      };

      img.src = canvas.getAttribute("data-src") || "/bubensahne.png";
    }

    initHalftone();
  </script>
</Base>
